{
  "name": "@inventory/core",
  "version": "0.1.0",
  "description": "Parser y motor de analítica para el Excel de inventario",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
